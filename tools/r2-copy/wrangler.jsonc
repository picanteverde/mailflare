{
	// picanteverde fork: daily R2 copy for mailflare (see worker.ts). Deploy with
	// `wrangler deploy -c tools/r2-copy/wrangler.jsonc [--env staging]`. No routes, no workers.dev.
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "mailflare-r2-copy",
	"main": "./worker.ts",
	"compatibility_date": "2026-05-20",
	"workers_dev": false,
	"preview_urls": false,
	// No cron of its own (QA): Cloudflare never invoked it, and mailflare's */5 cron steps the copy
	// over the R2_COPY service binding instead. An empty list also clears any registered schedule,
	// so two runs can never work on _state/pass.json at once.
	"triggers": { "crons": [] },
	"vars": { "BATCH": "200" },
	"r2_buckets": [
		{ "binding": "SOURCE", "bucket_name": "mailflare-raw" },
		{ "binding": "BACKUP", "bucket_name": "mailflare-backup" },
	],
	"observability": { "enabled": true },
	"env": {
		"staging": {
			"name": "mailflare-r2-copy-staging",
			"workers_dev": false,
			"preview_urls": false,
			"vars": { "BATCH": "200" },
			"r2_buckets": [
				{ "binding": "SOURCE", "bucket_name": "mailflare-staging-raw" },
				{ "binding": "BACKUP", "bucket_name": "mailflare-staging-backup" },
			],
		},
	},
}
