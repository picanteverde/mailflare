{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mailflare",
	"main": "./worker.ts",
	"compatibility_date": "2026-05-20",
	"keep_vars": true,
	// picanteverde fork: only reachable on the custom domain (behind WAF rules A/B).
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "mail.picanteverde.com", "custom_domain": true }],
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "none",
	},
	"images": {
		"binding": "IMAGES",
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "mailflare",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "REALTIME",
				"class_name": "RealtimeHub",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"RealtimeHub",
			],
		},
	],
	"triggers": {
		"crons": ["0 2 * * *", "*/5 * * * *"],
	},
	"ratelimits": [
		{
			"name": "LOGIN_RATE_LIMIT",
			"namespace_id": "1001",
			"simple": {
				"limit": 20,
				"period": 60,
			},
		},
		{
			"name": "AGENT_RATE_LIMIT",
			"namespace_id": "1002",
			"simple": { "limit": 120, "period": 60 },
		},
	],
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
	"send_email": [
		{
			"name": "EMAIL",
			"remote": false,
		},
	],
	// picanteverde fork: Workers AI removed (assistant/auto-draft would send mail content to a model).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mailflare",
			"database_id": "60d419f6-7b9e-471a-a25b-895f7714b8bc",
			"migrations_dir": "drizzle/migrations",
		},
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "mailflare-raw",
		},
	],
	"queues": {
		"producers": [
			{
				"binding": "INBOUND_QUEUE",
				"queue": "mailflare-inbound",
			},
			{
				"binding": "OUTBOUND_QUEUE",
				"queue": "mailflare-outbound",
			},
			{
				"binding": "AGENT_QUEUE",
				"queue": "mailflare-agent",
			},
		],
		"consumers": [
			{
				"queue": "mailflare-inbound",
				"max_batch_size": 5,
				"max_retries": 3,
			},
			{
				"queue": "mailflare-outbound",
				"max_batch_size": 5,
				"max_retries": 3,
			},
			{
				"queue": "mailflare-agent",
				"max_batch_size": 1,
				"max_retries": 3,
			},
		],
	},
	// picanteverde fork: Phase 9 staging (synthetic data only). Build and deploy with
	// CLOUDFLARE_ENV=staging. Bindings are not inherited, so each one points at a *-staging
	// resource; nothing here touches production. Reachable only from MAILFLARE_SETUP_IP (WAF).
	"env": {
		"staging": {
			"name": "mailflare-staging",
			"workers_dev": false,
			"preview_urls": false,
			"routes": [{ "pattern": "mail-staging.picanteverde.app", "custom_domain": true }],
			"services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "mailflare-staging" }],
			"durable_objects": { "bindings": [{ "name": "REALTIME", "class_name": "RealtimeHub" }] },
			"images": { "binding": "IMAGES" },
			"ratelimits": [
				{ "name": "LOGIN_RATE_LIMIT", "namespace_id": "2101", "simple": { "limit": 20, "period": 60 } },
				{ "name": "AGENT_RATE_LIMIT", "namespace_id": "2102", "simple": { "limit": 120, "period": 60 } },
			],
			// No real outbound mail: the binding can only deliver to this one verified address.
			"send_email": [{ "name": "EMAIL", "destination_address": "picanteverde@gmail.com" }],
			"d1_databases": [{
				"binding": "DB",
				"database_name": "mailflare-staging",
				"database_id": "0e8da697-edbd-4720-ae58-7e51bf670817",
				"migrations_dir": "drizzle/migrations",
			}],
			"r2_buckets": [{ "binding": "BUCKET", "bucket_name": "mailflare-staging-raw" }],
			"queues": {
				"producers": [
					{ "binding": "INBOUND_QUEUE", "queue": "mailflare-staging-inbound" },
					{ "binding": "OUTBOUND_QUEUE", "queue": "mailflare-staging-outbound" },
					{ "binding": "AGENT_QUEUE", "queue": "mailflare-staging-agent" },
				],
				"consumers": [
					{ "queue": "mailflare-staging-inbound", "max_batch_size": 5, "max_retries": 3 },
					{ "queue": "mailflare-staging-outbound", "max_batch_size": 5, "max_retries": 3 },
					{ "queue": "mailflare-staging-agent", "max_batch_size": 1, "max_retries": 3 },
				],
			},
		},
	},
}
